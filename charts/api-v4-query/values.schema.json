{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "centrifuge-api-v4-query values",
  "type": "object",
  "required": ["environment", "network", "id", "projectionId", "schema", "databaseSecretName", "image"],
  "properties": {
    "environment": { "type": "string", "pattern": "^(main|test)-(eu|us)$" },
    "network": { "enum": ["mainnet", "testnet"] },
    "id": { "type": "string", "pattern": "^q-[0-9]{8}-[0-9]{2}$" },
    "projectionId": { "type": "string", "pattern": "^pj-[0-9]{8}-[0-9]{2}$" },
    "schema": { "type": "string", "pattern": "^pj_[0-9]{8}_[0-9]{2}$" },
    "databaseSecretName": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "-app$" },
      "description": "Read-only query role Secret. The owner app Secret is refused."
    },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "displayTag": { "type": "string", "maxLength": 63 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "service": {
      "type": "object",
      "properties": {
        "type": { "const": "ClusterIP" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "resources": { "type": "object", "required": ["requests", "limits"] },
    "global": {
      "type": "object",
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "env": { "type": "array", "items": { "type": "object", "required": ["name"] } }
  }
}
