{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "centrifuge-api-v4-event-lake values",
  "type": "object",
  "required": ["environment", "network", "id", "generation", "selectedNetworks", "databaseSecretName", "image", "erpc", "global"],
  "properties": {
    "environment": { "type": "string", "pattern": "^(main|test)-(eu|us)$" },
    "network": { "enum": ["mainnet", "testnet"] },
    "id": { "type": "string", "pattern": "^pr-[0-9]{8}-[0-9]{2}$" },
    "generation": { "type": "string", "pattern": "^id[0-9]{12}$" },
    "selectedNetworks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "databaseSecretName": { "type": "string", "minLength": 1 },
    "envioSecretName": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "displayTag": { "type": "string", "maxLength": 63 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "erpc": {
      "type": "object",
      "required": ["urlTemplate"],
      "properties": {
        "urlTemplate": { "type": "string", "pattern": "^https?://.+%s" }
      }
    },
    "global": {
      "type": "object",
      "required": ["env"],
      "properties": {
        "env": {
          "type": "object",
          "required": ["REGISTRY_INCLUDE"],
          "properties": { "REGISTRY_INCLUDE": { "type": "string", "minLength": 1 } },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "indexer": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "env": { "type": "array", "items": { "type": "object", "required": ["name"] } }
      }
    }
  }
}
