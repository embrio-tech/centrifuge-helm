{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "centrifuge-api-v4-event-lake values",
  "type": "object",
  "required": ["environment", "network", "id", "generation", "databaseSecretName", "image", "erpc", "global"],
  "anyOf": [
    { "required": ["selectedNetworks"] },
    {
      "required": ["global"],
      "properties": {
        "global": {
          "required": ["env"],
          "properties": { "env": { "required": ["SELECTED_NETWORKS"] } }
        }
      }
    }
  ],
  "properties": {
    "environment": { "type": "string", "pattern": "^(main|test)-(eu|us)$" },
    "network": { "enum": ["mainnet", "testnet"] },
    "id": { "type": "string", "pattern": "^pr-[0-9]{8}-[0-9]{2}$" },
    "generation": { "type": "string", "pattern": "^id[0-9]{12}$" },
    "selectedNetworks": {
      "type": "array",
      "uniqueItems": true,
      "description": "Legacy top-level chain list. New Producers author SELECTED_NETWORKS in global.env instead; the chart derives this list internally. Empty is allowed only when global.env.SELECTED_NETWORKS is set.",
      "items": { "type": "integer", "minimum": 1 }
    },
    "databaseSecretName": { "type": "string", "minLength": 1 },
    "envioSecretName": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "displayTag": { "type": "string", "maxLength": 63 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "erpc": {
      "type": "object",
      "required": ["urlTemplate"],
      "properties": {
        "urlTemplate": { "type": "string", "pattern": "^https?://.+%s" }
      }
    },
    "global": {
      "type": "object",
      "required": ["env"],
      "properties": {
        "env": {
          "type": "object",
          "required": ["REGISTRY_INCLUDE"],
          "description": "Runtime env for the Producer. Registry data (heads, ABIs) now comes from registry.manifest.json baked into the image, so REGISTRY_URL, REGISTRY_URL_MAINNET and REGISTRY_URL_TESTNET are refused: the entrypoint rejects runtime registry URLs. Legitimate overrides REGISTRY_INCLUDE and REGISTRY_<revision>_* (non-ABI) are still allowed.",
          "properties": {
            "REGISTRY_INCLUDE": { "type": "string", "minLength": 1 },
            "SELECTED_NETWORKS": {
              "type": "string",
              "pattern": "^[0-9]+(,[0-9]+)*$",
              "description": "Comma-separated chain ids this Producer indexes. Preferred over the legacy top-level selectedNetworks list."
            }
          },
          "patternProperties": {
            "^(REGISTRY_URL|REGISTRY_URL_MAINNET|REGISTRY_URL_TESTNET)$": { "not": {} }
          },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "indexer": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "env": {
          "type": "array",
          "description": "Extra container env. Registry URLs are refused here too: the image carries registry.manifest.json and never fetches a runtime registry head.",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "not": { "enum": ["REGISTRY_URL", "REGISTRY_URL_MAINNET", "REGISTRY_URL_TESTNET"] }
              }
            }
          }
        }
      }
    }
  }
}
