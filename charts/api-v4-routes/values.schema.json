{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "centrifuge-api-v4-routes values",
  "type": "object",
  "required": [
    "environment",
    "stagingQuery",
    "productionQuery",
    "rollbackQuery"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "pattern": "^(main|test)-(eu|us)$"
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "stagingQuery": {
      "$ref": "#/definitions/queryId"
    },
    "productionQuery": {
      "$ref": "#/definitions/queryId"
    },
    "rollbackQuery": {
      "$ref": "#/definitions/queryId"
    }
  },
  "definitions": {
    "queryId": {
      "type": "string",
      "pattern": "^q-[0-9]{8}-[0-9]{2}$"
    }
  }
}
